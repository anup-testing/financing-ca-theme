{
	"name": "tankless/the-tankless-theme",
	"description": "Block theme for The Tankless (thetankless.ca), structured after rtCamp's theme-elementary.",
	"type": "wordpress-theme",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"rtcamp/wp-primitives": "^2.1.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.5",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^3.0",
		"phpstan/phpstan": "^2.1",
		"php-stubs/wp-cli-stubs": "*",
		"rtcamp/wp-phpcs": "^1.0",
		"rtcamp/wp-phpstan": "^1.0"
	},
	"autoload": {
		"psr-4": { "Tankless\\Theme\\": "inc/" }
	},
	"autoload-dev": {
		"psr-4": { "Tankless\\Theme\\Tests\\": "tests/php/" }
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcs:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"pot": "wp i18n make-pot . ./languages/the-tankless.pot --domain=the-tankless --include=\"inc,patterns,assets/build/js\""
	}
}
