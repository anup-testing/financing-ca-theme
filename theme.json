{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {
          "slug": "ink",
          "color": "#06203f",
          "name": "Ink"
        },
        {
          "slug": "body",
          "color": "#41536b",
          "name": "Body"
        },
        {
          "slug": "tint",
          "color": "#f5f8fc",
          "name": "Tint"
        },
        {
          "slug": "brand",
          "color": "#0a5cff",
          "name": "Brand blue"
        },
        {
          "slug": "accent",
          "color": "#00b779",
          "name": "Accent green"
        },
        {
          "slug": "amber",
          "color": "#f0a500",
          "name": "Amber"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "instrument-serif",
          "name": "Instrument Serif",
          "fontFamily": "'Instrument Serif', Georgia, serif"
        }
      ]
    },
    "spacing": {
      "blockGap": false
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#41536b"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "17px",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "0"
    }
  },
  "customTemplates": [
    {
      "name": "page-home",
      "title": "Home Page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}