{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1180px"
    },
    "color": {
      "palette": [
        {
          "slug": "base",
          "color": "#0b0c0e",
          "name": "Base (page)"
        },
        {
          "slug": "surface",
          "color": "#121317",
          "name": "Surface"
        },
        {
          "slug": "card",
          "color": "#16181d",
          "name": "Card"
        },
        {
          "slug": "line",
          "color": "#23262d",
          "name": "Line"
        },
        {
          "slug": "heading",
          "color": "#ffffff",
          "name": "Heading"
        },
        {
          "slug": "body",
          "color": "#a9adb5",
          "name": "Body"
        },
        {
          "slug": "muted",
          "color": "#6f747d",
          "name": "Muted"
        },
        {
          "slug": "brand",
          "color": "#2aa8ea",
          "name": "Brand blue"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "manrope",
          "name": "Manrope",
          "fontFamily": "'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "exo-2",
          "name": "Exo 2",
          "fontFamily": "'Exo 2', 'Manrope', sans-serif"
        }
      ]
    },
    "spacing": {
      "blockGap": false
    }
  },
  "styles": {
    "color": {
      "background": "#0b0c0e",
      "text": "#a9adb5"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "16px",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "0"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--exo-2)",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "#2aa8ea"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-about",
      "title": "About Page",
      "postTypes": [
        "page"
      ]
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
